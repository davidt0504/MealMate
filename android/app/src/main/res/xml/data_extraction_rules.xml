<?xml version="1.0" encoding="utf-8"?>
<!-- Excludes everything from cloud backup and device-to-device transfer: the SQLite
     database is the household's local source of truth and must not be silently clouded
     (PRD v3 §6.5). In-app export is the sanctioned egress path. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
